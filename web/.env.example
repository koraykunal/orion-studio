# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Managed PostgreSQL. Use sslmode=require for anything that is not localhost.
# The app opens a pg.Pool per process, so keep the connection limit in mind:
# max_connections_on_your_plan >= (replicas * POOL_MAX) + headroom_for_migrations
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DATABASE?sslmode=require"

# Optional pool ceiling. Defaults to 10 (node-postgres default) when unset.
# DB_POOL_MAX="10"
# DB_POOL_IDLE_TIMEOUT_MS="30000"
# DB_POOL_CONNECTION_TIMEOUT_MS="10000"

# ---------------------------------------------------------------------------
# Auth
# ---------------------------------------------------------------------------
# Generate with: openssl rand -base64 32
AUTH_SECRET="replace-with-a-strong-random-secret"

# Auth.js needs a trusted Host header when it sits behind a reverse proxy,
# which this app always does. lib/auth.ts sets trustHost from this value and
# defaults it to on, so the line can be omitted entirely.
#
# Do NOT set it to false: that makes Auth.js throw UntrustedHost on
# /api/auth/* and on every protected route.
# AUTH_TRUST_HOST="true"

# First admin account, consumed by `npx tsx prisma/seed.ts` only.
# Never committed. Change the password after the first run.
ADMIN_EMAIL="you@example.com"
ADMIN_PASSWORD="replace-with-at-least-12-chars"
# ADMIN_NAME="Your Name"

# ---------------------------------------------------------------------------
# Public site
# ---------------------------------------------------------------------------
# Single source of truth for metadata, canonical URLs, sitemap, robots,
# JSON-LD and IndexNow. Falls back to https://orionstud.io when unset.
#
# NEXT_PUBLIC_* values are inlined at BUILD time, not at runtime. The
# Dockerfile declares them as build args, so they must also be passed via
# `build.args` in docker-compose.yml or the shipped bundle will not contain them.
NEXT_PUBLIC_SITE_URL="https://orionstud.io"

# Public WhatsApp/phone number, digits only, no + and no formatting.
# Powers the WhatsApp and tel: CTAs sitewide.
NEXT_PUBLIC_WHATSAPP="905xxxxxxxxx"

# ---------------------------------------------------------------------------
# Contact form mail delivery
# ---------------------------------------------------------------------------
# OPTIONAL. The contact route writes the inquiry to the database first and only
# then attempts delivery, so with SMTP unset the form still works and messages
# are readable at /admin/messages. You just get no notification email.
#
# Port 465 is implicit TLS. Port 587 is STARTTLS; the client negotiates it
# automatically. Both are supported, nothing to configure.
SMTP_HOST="smtp.example.com"
SMTP_PORT="465"
SMTP_USER="info@example.com"
SMTP_PASS="replace-with-smtp-password"
# Envelope sender. Defaults to SMTP_USER when unset.
# SMTP_FROM="info@example.com"
# EHLO name sent to the server. Defaults to orionstud.io.
# SMTP_HELO="orionstud.io"

# ---------------------------------------------------------------------------
# SEO
# ---------------------------------------------------------------------------
# Optional. The key is served publicly at /api/indexnow-key, which is what the
# IndexNow protocol requires. Leave empty to disable IndexNow entirely.
INDEXNOW_KEY=""
