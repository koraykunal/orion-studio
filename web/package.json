        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "gsap": "^3.14.2",
        "lenis": "^1.3.17",
        "lucide-react": "^0.562.0",
        "next": "^16.3.5",
        "next-auth": "5.0.0-beta.32",
        "next-intl": "^4.13.2",
